{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "plugmem-opencode",
  "version": "0.1.0",
  "description": "PlugMem long-term memory for OpenCode: automatic per-repo recall, promotion-gated writing, and manual recall/remember tools.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "sync-core": "bash scripts/sync-core.sh"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugmem",
    "memory",
    "agent-memory",
    "long-term-memory"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.1.2",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.1.2",
    "@types/node": "^22.10.0",
    "effect": "^4.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
